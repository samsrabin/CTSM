module test_WaterState_CalculateTotalH2osno

  ! Tests of WaterStateType: CalculateTotalH2osno

  ! CalculateTotalH2osno sums a column's snow water: the layerless snow
  ! h2osno_no_layers, plus h2osoi_ice + h2osoi_liq over the pack. In a debug build it
  ! first calls CheckSnowConsistency, which aborts through endrun if any slot above the
  ! pack holds ice or liquid that is neither 0 nor spval.
  !
  ! Terms used below:
  ! - A "slot" is one index (vertical level) of the column arrays in -nlevsno+1 .. 0,
  !   whether or not a snow layer occupies it.
  ! - The "pack" is the run of slots that do hold snow (jtop .. jbot; short for
  !   col%get_jtop_snow(c) .. col%get_jbot_snow(c)).
  ! - "snl" is col%snl, which is NEGATIVE the number of snow layers.
  !
  ! The NVP change touches both routines. The sum runs jtop .. jbot, so it reaches the
  ! top snow layer at snl and stops short of the moss. CheckSnowConsistency's scan of
  ! slots that should be empty runs -nlevsno+1 .. jtop-1, so it stops short of the moss
  ! too -- otherwise the moss water would look like snow left outside the pack.

  use funit
  use shr_kind_mod, only : r8 => shr_kind_r8
  use unittestSubgridMod
  use unittestSimpleSubgridSetupsMod, only : setup_single_veg_patch
  use unittestFilterBuilderMod, only : filter_from_range
  use unittestWaterTypeFactory, only : unittest_water_type_factory_type
  use WaterType, only : water_type
  use ColumnType, only : col
  use clm_varpar, only : nlevsno

  implicit none

  @TestCase
  type, extends(TestCase) :: TestCalcTotalH2osno
     type(unittest_water_type_factory_type) :: water_factory
     type(water_type) :: water_inst
   contains
     procedure :: setUp
     procedure :: tearDown
     procedure :: setupColumn
  end type TestCalcTotalH2osno

  ! Column shape handed to the water type factory. nlevsno = 5 leaves at least one empty
  ! slot above a three-layer pack in both the stock and the NVP layout.
  integer, parameter :: my_nlevsoi = 3
  integer, parameter :: nlevgrnd_additional = 1
  integer, parameter :: my_nlevsno = 5

  real(r8), parameter :: tol = 1.e-13_r8

  ! Water for the three snow layers. The per-slot totals are 101, 202 and 404, which are
  ! powers of two apart, so every possible wrong choice of loop bounds gives a different
  ! total and no two errors can cancel.
  real(r8), parameter :: ice_top = 100._r8, liq_top = 1._r8
  real(r8), parameter :: ice_mid = 200._r8, liq_mid = 2._r8
  real(r8), parameter :: ice_btm = 400._r8, liq_btm = 4._r8

  ! Water held in the moss slot, larger than the whole pack combined. It is not snow, so
  ! it must never enter h2osno_total, and it must not trip CheckSnowConsistency either.
  real(r8), parameter :: ice_nvp = 1000._r8, liq_nvp = 10._r8

contains

  subroutine setUp(this)
    ! Runs before every test: fixes the vertical grid the water type factory will build
    ! on. The subgrid is left to setupColumn, since each test picks its own snl and
    ! jbot_sno. tearDown undoes both.
    class(TestCalcTotalH2osno), intent(inout) :: this

    call this%water_factory%init()
    call this%water_factory%setup_before_subgrid( &
         my_nlevsoi = my_nlevsoi, &
         nlevgrnd_additional = nlevgrnd_additional, &
         my_nlevsno = my_nlevsno)
  end subroutine setUp

  subroutine tearDown(this)
    ! Runs after every test, releasing the water type and the subgrid setupColumn built.
    class(TestCalcTotalH2osno), intent(inout) :: this

    call this%water_factory%teardown(this%water_inst)
    call unittest_subgrid_teardown()
  end subroutine tearDown

  subroutine setupColumn(this, snl, jbot_sno)
    ! Build the single column each test works on and clear all snow-range water, so that
    ! whatever the test assigns afterwards is the only water present. Clearing is not
    ! just tidiness: CheckSnowConsistency runs from inside the routine under test and
    ! aborts unless every slot above the pack holds 0 or spval. jbot_sno = -1 makes it an
    ! NVP column and 0 a stock one.
    class(TestCalcTotalH2osno), intent(inout) :: this
    integer, intent(in) :: snl
    integer, intent(in) :: jbot_sno

    call setup_single_veg_patch(pft_type = 1)
    col%jbot_sno(bounds%begc:bounds%endc) = jbot_sno
    call this%water_factory%setup_after_subgrid(snl = snl, dz = 0.05_r8)
    call this%water_factory%create_water_type(this%water_inst)

    associate(ws => this%water_inst%waterstatebulk_inst)
    ws%h2osoi_ice_col(bounds%begc:bounds%endc, -nlevsno+1:0) = 0._r8
    ws%h2osoi_liq_col(bounds%begc:bounds%endc, -nlevsno+1:0) = 0._r8
    ws%h2osno_no_layers_col(bounds%begc:bounds%endc) = 0._r8
    end associate
  end subroutine setupColumn

  @Test
  subroutine totalH2osno_partialPack_stock(this)
    ! On a stock column, CalculateTotalH2osno must total the ice and liquid of every snow
    ! layer down to the one resting on the soil surface.
    !
    ! Complementary to totalH2osno_nvp: the same three layer waters and the same snl,
    ! differing only in whether the moss slot is claimed and so in where the pack sits.
    ! The expected total is the same in both, so the pair brackets the sum's range from
    ! both sides; this one pins what it must be with every slot down to the soil surface
    ! available to snow.
    class(TestCalcTotalH2osno), intent(inout) :: this
    ! The layer count the column carries; the routine only reads it.
    integer, parameter :: snl = -3
    ! jbot_sno is 0 on a stock column, so the sum's lower bound is snl+1 and
    ! get_jbot_snow puts the pack's bottom slot at the soil surface.
    integer, parameter :: jtop = snl + 1
    integer, parameter :: jbot = 0
    integer :: num_c, c
    integer, allocatable :: filter_c(:)  ! [1:num_c]
    real(r8) :: h2osno_total(1)
    real(r8) :: expected

    expected = ice_top + liq_top + ice_mid + liq_mid + ice_btm + liq_btm
    call this%setupColumn(snl = snl, jbot_sno = 0)
    call filter_from_range(bounds%begc, bounds%endc, num_c, filter_c)
    c = bounds%begc

    associate(ws => this%water_inst%waterstatebulk_inst)
    ws%h2osoi_ice_col(c,jtop) = ice_top
    ws%h2osoi_liq_col(c,jtop) = liq_top
    ws%h2osoi_ice_col(c,jtop+1) = ice_mid
    ws%h2osoi_liq_col(c,jtop+1) = liq_mid
    ws%h2osoi_ice_col(c,jbot) = ice_btm
    ws%h2osoi_liq_col(c,jbot) = liq_btm

    call ws%CalculateTotalH2osno(bounds, num_c, filter_c, 'test', h2osno_total)
    end associate

    @assertEqual(expected, h2osno_total(c), tolerance=tol)
  end subroutine totalH2osno_partialPack_stock

  @Test
  subroutine totalH2osno_partialPack_nvp(this)
    ! On an NVP column, CalculateTotalH2osno must total the ice and liquid of every snow
    ! layer down to the one resting on the moss, leaving out the water the moss slot
    ! holds below the pack.
    !
    ! Complementary to totalH2osno_stock: the same three layer waters and the same snl,
    ! differing only in whether the moss slot is claimed and so in where the pack sits.
    ! Here the pack runs -3..-1 and the moss slot at 0 carries water of its own. The
    ! expected total is the same as in the stock case, so the two tests bracket the
    ! range from both sides: the sum must reach the top snow layer at snl = -3, which
    ! the pre-NVP lower bound of snl+1 = -2 would miss, and must stop at -1, whereas the
    ! pre-NVP upper bound of 0 would fold in the moss. Either error moves the total, and
    ! the moss water is large enough that the second one cannot be mistaken for
    ! roundoff.
    class(TestCalcTotalH2osno), intent(inout) :: this
    ! The layer count the column carries; the routine only reads it.
    integer, parameter :: snl = -3
    ! jtop = snl+1+jbot_sno, and jbot_sno is -1 on an NVP column, so the sum's lower
    ! bound is snl itself. get_jbot_snow is jbot_sno, so the pack ends at -1 and the
    ! moss slot sits just below it at 0, outside the sum.
    integer, parameter :: jtop = snl
    integer, parameter :: jbot = -1
    integer, parameter :: j_moss = 0
    integer :: num_c, c
    integer, allocatable :: filter_c(:)  ! [1:num_c]
    real(r8) :: h2osno_total(1)
    real(r8) :: expected

    expected = ice_top + liq_top + ice_mid + liq_mid + ice_btm + liq_btm
    call this%setupColumn(snl = snl, jbot_sno = -1)
    call filter_from_range(bounds%begc, bounds%endc, num_c, filter_c)
    c = bounds%begc

    associate(ws => this%water_inst%waterstatebulk_inst)
    ws%h2osoi_ice_col(c,jtop) = ice_top
    ws%h2osoi_liq_col(c,jtop) = liq_top
    ws%h2osoi_ice_col(c,jtop+1) = ice_mid
    ws%h2osoi_liq_col(c,jtop+1) = liq_mid
    ws%h2osoi_ice_col(c,jbot) = ice_btm
    ws%h2osoi_liq_col(c,jbot) = liq_btm
    ws%h2osoi_ice_col(c,j_moss) = ice_nvp
    ws%h2osoi_liq_col(c,j_moss) = liq_nvp

    call ws%CalculateTotalH2osno(bounds, num_c, filter_c, 'test', h2osno_total)
    end associate

    @assertEqual(expected, h2osno_total(c), tolerance=tol)
  end subroutine totalH2osno_partialPack_nvp

  @Test
  subroutine totalH2osno_onlyLayerlessSnow_stock(this)
    ! On a snow-free non-NVP column, CalculateTotalH2osno must return the layerless snow
    ! alone and must complete without its consistency check mistaking the water in the
    ! moss slot for snow stranded above the pack.
    !
    ! snl = 0 makes jtop -1 and jbot 0, so the sum loop runs over nothing and the total
    ! is the layerless snow alone.
    !
    ! What this case tests is mainly that the call completes at all, given CheckSnowConsistency.

    class(TestCalcTotalH2osno), intent(inout) :: this

    ! A bare column: no snow layers at all. jtop = snl+1+jbot_sno is then 0 on an NVP
    ! column, so the pack's top slot coincides with the moss slot, the sum loop runs
    ! over nothing, and CheckSnowConsistency's scan of -nlevsno+1 .. jtop-1 stops just
    ! above the moss.
    integer, parameter :: snl = 0
    integer, parameter :: jbot_sno = 0
    integer :: num_c, c
    integer, allocatable :: filter_c(:)  ! [1:num_c]
    real(r8) :: h2osno_total(1)
    real(r8), parameter :: h2osno_no_layers = 33._r8

    call this%setupColumn(snl = snl, jbot_sno = jbot_sno)
    call filter_from_range(bounds%begc, bounds%endc, num_c, filter_c)
    c = bounds%begc

    associate(ws => this%water_inst%waterstatebulk_inst)
    ws%h2osno_no_layers_col(c) = h2osno_no_layers

    call ws%CalculateTotalH2osno(bounds, num_c, filter_c, 'test', h2osno_total)
    end associate

    @assertEqual(h2osno_no_layers, h2osno_total(c), tolerance=tol)
  end subroutine totalH2osno_onlyLayerlessSnow_stock

  @Test
  subroutine totalH2osno_onlyLayerlessSnow_nvp(this)
    ! On a snow-free NVP column, CalculateTotalH2osno must return the layerless snow
    ! alone and must complete without its consistency check mistaking the water in the
    ! moss slot for snow stranded above the pack.
    !
    ! snl = 0 makes jtop 0 and jbot -1, so the sum loop runs over nothing and the total
    ! is the layerless snow alone.
    !
    ! What this case tests is mainly that the call completes at all, given CheckSnowConsistency.
    ! CheckSnowConsistency scans -nlevsno+1 .. jtop-1 for slots that should be empty;
    ! under the pre-NVP bound that range ends at snl = 0 and so includes the moss slot,
    ! where ice_nvp is neither 0 nor spval, so the run would abort through endrun. That
    ! is why the moss water is set here even though it contributes nothing to the
    ! expected value.

    class(TestCalcTotalH2osno), intent(inout) :: this

    ! A bare column: no snow layers at all. jtop = snl+1+jbot_sno is then 0 on an NVP
    ! column, so the pack's top slot coincides with the moss slot, the sum loop runs
    ! over nothing, and CheckSnowConsistency's scan of -nlevsno+1 .. jtop-1 stops just
    ! above the moss.
    integer, parameter :: snl = 0
    integer, parameter :: jbot_sno = -1
    integer, parameter :: j_moss = 0
    integer :: num_c, c
    integer, allocatable :: filter_c(:)  ! [1:num_c]
    real(r8) :: h2osno_total(1)
    real(r8), parameter :: h2osno_no_layers = 33._r8

    call this%setupColumn(snl = snl, jbot_sno = jbot_sno)
    call filter_from_range(bounds%begc, bounds%endc, num_c, filter_c)
    c = bounds%begc

    associate(ws => this%water_inst%waterstatebulk_inst)
    ws%h2osno_no_layers_col(c) = h2osno_no_layers
    ws%h2osoi_ice_col(c,j_moss) = ice_nvp
    ws%h2osoi_liq_col(c,j_moss) = liq_nvp

    call ws%CalculateTotalH2osno(bounds, num_c, filter_c, 'test', h2osno_total)
    end associate

    @assertEqual(h2osno_no_layers, h2osno_total(c), tolerance=tol)
  end subroutine totalH2osno_onlyLayerlessSnow_nvp

end module test_WaterState_CalculateTotalH2osno
