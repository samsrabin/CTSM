module test_total_water_and_heat

  ! Tests of TotalWaterAndHeatMod

  use funit
  use TotalWaterAndHeatMod
  use shr_kind_mod , only : r8 => shr_kind_r8
  use unittestSubgridMod
  use unittestSimpleSubgridSetupsMod
  use unittestFilterBuilderMod, only : filter_from_range
  use unittestWaterTypeFactory, only : unittest_water_type_factory_type
  use WaterType, only : water_type
  use ColumnType, only : col
  use clm_varcon, only : tfrz, cpliq, hfus
  use clm_varpar, only : nlevsno

  implicit none

  @TestCase
  type, extends(TestCase) :: TestTWAH
     type(unittest_water_type_factory_type) :: water_factory
     type(water_type) :: water_inst
   contains
     procedure :: setUp
     procedure :: tearDown
     procedure :: setupColumn
  end type TestTWAH

  real(r8), parameter :: tol = 1.e-13_r8
  real(r8), parameter :: irrelevant_temp = tfrz + 9999._r8

  ! Column shape handed to the water type factory, used by the ComputeLiqIceMassNonLake
  ! tests at the bottom of this file.
  integer, parameter :: my_nlevsoi = 3
  integer, parameter :: nlevgrnd_additional = 1
  integer, parameter :: my_nlevsno = 5

  ! Water put in the top snow layer and in the slot at index 0. Distinct values, so a sum
  ! that started one slot too low or stopped one slot too soon changes by a recognizable
  ! amount rather than by nothing.
  real(r8), parameter :: ice_top = 100._r8, liq_top = 1._r8
  real(r8), parameter :: ice_zero = 400._r8, liq_zero = 4._r8

  ! Water put in the slot immediately above the top snow layer, which the sum must not
  ! reach. Larger than either of the above so that including it would be unmistakable.
  real(r8), parameter :: ice_above = 999._r8, liq_above = 9._r8

contains

  subroutine setUp(this)
    class(TestTWAH), intent(inout) :: this

    call this%water_factory%init()
    call this%water_factory%setup_before_subgrid( &
         my_nlevsoi = my_nlevsoi, &
         nlevgrnd_additional = nlevgrnd_additional, &
         my_nlevsno = my_nlevsno)
  end subroutine setUp

  subroutine tearDown(this)
    class(TestTWAH), intent(inout) :: this

    call this%water_factory%teardown(this%water_inst)
    call unittest_subgrid_teardown()
  end subroutine tearDown

  subroutine setupColumn(this, snl, jbot_sno)
    ! Build a single column with the given snow layer count and bottom snow index, and
    ! empty every snow-range slot so that whatever a test assigns afterwards is the only
    ! water in that range. jbot_sno = -1 makes it an NVP column and 0 a stock one. Used
    ! only by the ComputeLiqIceMassNonLake tests at the bottom of this file.
    class(TestTWAH), intent(inout) :: this
    integer, intent(in) :: snl
    integer, intent(in) :: jbot_sno

    call setup_single_veg_patch(pft_type = 1)
    col%jbot_sno(bounds%begc:bounds%endc) = jbot_sno
    call this%water_factory%setup_after_subgrid(snl = snl, dz = 0.05_r8)
    call this%water_factory%create_water_type(this%water_inst)

    associate(ws => this%water_inst%waterstatebulk_inst)
    ws%h2osoi_ice_col(bounds%begc:bounds%endc, -nlevsno+1:0) = 0._r8
    ws%h2osoi_liq_col(bounds%begc:bounds%endc, -nlevsno+1:0) = 0._r8
    ws%h2osno_no_layers_col(bounds%begc:bounds%endc) = 0._r8
    end associate
  end subroutine setupColumn

  ! ------------------------------------------------------------------------
  ! Tests of LiquidWaterHeat
  ! ------------------------------------------------------------------------

  @Test
  subroutine LiquidWaterHeatBasic(this)
    class(TestTWAH), intent(inout) :: this
    real(r8), parameter :: h2o = 3._r8
    real(r8), parameter :: temp_above_base = 4._r8
    real(r8), parameter :: temp = heat_base_temp + temp_above_base
    real(r8) :: heat
    real(r8) :: expected_heat, expected_latent_heat, expected_total

    heat = LiquidWaterHeat(temp = temp, h2o = h2o)
    expected_latent_heat = h2o * hfus
    expected_heat = h2o * cpliq * temp_above_base
    expected_total = expected_latent_heat + expected_heat

    @assertEqual(expected_total, heat, tolerance=tol)
  end subroutine LiquidWaterHeatBasic

  ! ------------------------------------------------------------------------
  ! Tests of AdjustDeltaHeatForDeltaLiq
  ! ------------------------------------------------------------------------

  @Test
  subroutine AdjustDeltaHeatNoDeltaLiq(this)
    class(TestTWAH), intent(inout) :: this
    real(r8) :: delta_heat(1)
    real(r8), parameter :: delta_liq = 0._r8
    real(r8), parameter :: delta_heat_init = 17._r8

    call setup_single_veg_patch(pft_type = 1)

    delta_heat(1) = delta_heat_init

    call AdjustDeltaHeatForDeltaLiq(bounds, [delta_liq], &
         [irrelevant_temp], [irrelevant_temp], &
         delta_heat)

    @assertEqual(delta_heat(1), delta_heat_init)
  end subroutine AdjustDeltaHeatNoDeltaLiq

  @Test
  subroutine AdjustDeltaHeatNegativeDeltaLiq(this)
    class(TestTWAH), intent(inout) :: this
    real(r8) :: delta_heat(1)
    real(r8) :: heat_diff
    real(r8) :: expected_total_heat
    real(r8), parameter :: liquid_water_temp1 = tfrz + 3._r8
    real(r8), parameter :: delta_heat_init = 17._r8
    real(r8), parameter :: delta_liq = -2._r8

    call setup_single_veg_patch(pft_type = 1)
    
    delta_heat(1) = delta_heat_init

    call AdjustDeltaHeatForDeltaLiq(bounds, [delta_liq], &
         [liquid_water_temp1], [irrelevant_temp], &
         delta_heat)
    heat_diff = delta_heat(1) - delta_heat_init

    expected_total_heat = LiquidWaterHeat( &
         temp = liquid_water_temp1, &
         h2o = -delta_liq)

    @assertLessThan(0._r8, heat_diff)
    @assertEqual(expected_total_heat, heat_diff, tolerance=tol)

  end subroutine AdjustDeltaHeatNegativeDeltaLiq

  @Test
  subroutine AdjustDeltaHeatPositiveDeltaLiq(this)
    class(TestTWAH), intent(inout) :: this
    real(r8) :: delta_heat(1)
    real(r8) :: heat_diff
    real(r8) :: expected_total_heat
    real(r8), parameter :: liquid_water_temp2 = tfrz + 3._r8
    real(r8), parameter :: delta_heat_init = 17._r8
    real(r8), parameter :: delta_liq = 2._r8

    call setup_single_veg_patch(pft_type = 1)
    
    delta_heat(1) = delta_heat_init

    call AdjustDeltaHeatForDeltaLiq(bounds, [delta_liq], &
         [irrelevant_temp], [liquid_water_temp2], &
         delta_heat)
    heat_diff = delta_heat(1) - delta_heat_init

    expected_total_heat = LiquidWaterHeat( &
         temp = liquid_water_temp2, &
         h2o = -delta_liq)

    @assertGreaterThan(0._r8, heat_diff)
    @assertEqual(expected_total_heat, heat_diff, tolerance=tol)

  end subroutine AdjustDeltaHeatPositiveDeltaLiq

  @Test
  subroutine AdjustDeltaHeatVeryColdTemperature(this)
    class(TestTWAH), intent(inout) :: this
    real(r8) :: delta_heat(1)
    real(r8) :: heat_diff
    real(r8) :: expected_total_heat
    real(r8), parameter :: liquid_water_temp2 = DeltaLiqMinTemp - 1._r8
    real(r8), parameter :: delta_heat_init = 17._r8
    real(r8), parameter :: delta_liq = 2._r8

    call setup_single_veg_patch(pft_type = 1)
    
    delta_heat(1) = delta_heat_init

    call AdjustDeltaHeatForDeltaLiq(bounds, [delta_liq], &
         [irrelevant_temp], [liquid_water_temp2], &
         delta_heat)
    heat_diff = delta_heat(1) - delta_heat_init

    expected_total_heat = LiquidWaterHeat( &
         temp = DeltaLiqMinTemp, &
         h2o = -delta_liq)

    @assertEqual(expected_total_heat, heat_diff, tolerance=tol)
  end subroutine AdjustDeltaHeatVeryColdTemperature

  @Test
  subroutine AdjustDeltaHeatVeryHotTemperature(this)
    class(TestTWAH), intent(inout) :: this
    real(r8) :: delta_heat(1)
    real(r8) :: heat_diff
    real(r8) :: expected_total_heat
    real(r8), parameter :: liquid_water_temp2 = DeltaLiqMaxTemp + 1._r8
    real(r8), parameter :: delta_heat_init = 17._r8
    real(r8), parameter :: delta_liq = 2._r8

    call setup_single_veg_patch(pft_type = 1)
    
    delta_heat(1) = delta_heat_init

    call AdjustDeltaHeatForDeltaLiq(bounds, [delta_liq], &
         [irrelevant_temp], [liquid_water_temp2], &
         delta_heat)
    heat_diff = delta_heat(1) - delta_heat_init

    expected_total_heat = LiquidWaterHeat( &
         temp = DeltaLiqMaxTemp, &
         h2o = -delta_liq)

    @assertEqual(expected_total_heat, heat_diff, tolerance=tol)
  end subroutine AdjustDeltaHeatVeryHotTemperature

  ! ------------------------------------------------------------------------
  ! Tests of ComputeLiqIceMassNonLake
  ! ------------------------------------------------------------------------

  ! ComputeLiqIceMassNonLake totals a column's water for the water balance check. Over
  ! the snow range it sums col%get_jtop_snow(c) .. 0 -- note the fixed upper bound of 0,
  ! unlike the snow routines, which stop at col%get_jbot_snow(c).
  !
  ! Terms used below. A "slot" is one index of the column arrays in -nlevsno+1 .. 0,
  ! whether or not a snow layer occupies it. The "pack" is the run of slots that hold
  ! snow, snl .. -1 on an NVP column (jbot_sno == -1, slot 0 being the moss slot) and
  ! snl+1 .. 0 on a stock one (jbot_sno == 0, no moss slot).
  !
  ! The NVP change is only to the lower bound: get_jtop_snow(c) rather than snl(c)+1, so
  ! that the sum still starts at the top snow layer once the moss takes index 0. The
  ! upper bound deliberately stays at 0 and so keeps the moss slot inside the column
  ! total, because snow handing water to the moss is a transfer within the column and
  ! must not read as a sink in errh2o.
  !
  ! Both tests below call the routine twice: once before any water is placed, to get a
  ! baseline covering the soil water and everything else the routine adds, and once
  ! after. Only the difference is asserted, which isolates the snow-range contribution
  ! without having to predict the rest of the column total.

  @Test
  subroutine ComputeLiqIceMass_nvp(this)
    ! On an NVP column, ComputeLiqIceMassNonLake must count the water of every snow layer
    ! together with the water the moss slot holds below the pack, and must not reach the
    ! empty slots above the pack, so that snow handed to the moss stays inside the column
    ! total instead of reading as a sink.
    !
    ! An NVP column with three snow layers, so the pack is -3..-1 and the moss is at 0.
    ! Water goes into the top snow layer at -3, into the moss slot at 0, and into slot -4
    ! just above the pack. The difference must pick up the first two and not the third:
    ! the pre-NVP lower bound would start at -2 and so miss the top snow layer, while a
    ! sum that stopped at jbot would drop the moss.
    class(TestTWAH), intent(inout) :: this
    ! The layer count the column carries; the routine only reads it.
    integer, parameter :: snl = -3
    ! jtop = snl+1+jbot_sno, and jbot_sno is -1 on an NVP column, so the sum's lower
    ! bound is snl itself. j_above is the empty slot just above the pack, which the sum
    ! must not reach; j_moss is the slot the sum's fixed upper bound of 0 keeps inside
    ! the total even though it lies below the pack.
    integer, parameter :: jtop = snl
    integer, parameter :: j_above = jtop - 1
    integer, parameter :: j_moss = 0
    integer :: num_c, c
    integer, allocatable :: filter_c(:)
    real(r8) :: liquid_base(1), ice_base(1)
    real(r8) :: liquid_mass(1), ice_mass(1)

    call this%setupColumn(snl = snl, jbot_sno = -1)
    call filter_from_range(bounds%begc, bounds%endc, num_c, filter_c)
    c = bounds%begc
    liquid_base(:) = 0._r8
    ice_base(:) = 0._r8
    liquid_mass(:) = 0._r8
    ice_mass(:) = 0._r8

    associate(ws => this%water_inst%waterstatebulk_inst)
    call ComputeLiqIceMassNonLake(bounds, num_c, filter_c, &
         ws, this%water_inst%waterdiagnosticbulk_inst, &
         subtract_dynbal_baselines = .false., &
         liquid_mass = liquid_base, ice_mass = ice_base)

    ws%h2osoi_ice_col(c,j_above) = ice_above
    ws%h2osoi_liq_col(c,j_above) = liq_above
    ws%h2osoi_ice_col(c,jtop) = ice_top
    ws%h2osoi_liq_col(c,jtop) = liq_top
    ws%h2osoi_ice_col(c,j_moss) = ice_zero
    ws%h2osoi_liq_col(c,j_moss) = liq_zero

    call ComputeLiqIceMassNonLake(bounds, num_c, filter_c, &
         ws, this%water_inst%waterdiagnosticbulk_inst, &
         subtract_dynbal_baselines = .false., &
         liquid_mass = liquid_mass, ice_mass = ice_mass)
    end associate

    @assertEqual(ice_top + ice_zero, ice_mass(c) - ice_base(c), tolerance=tol)
    @assertEqual(liq_top + liq_zero, liquid_mass(c) - liquid_base(c), tolerance=tol)
  end subroutine ComputeLiqIceMass_nvp

  @Test
  subroutine ComputeLiqIceMass_stock(this)
    ! On a stock column, which carries no moss slot, ComputeLiqIceMassNonLake must count
    ! the water of every snow layer down to the one resting on the soil surface and
    ! nothing in the empty slots above the pack, confirming the reindexed lower bound
    ! reduces to the stock one.
    !
    ! The same three layers on a stock column, where the pack is -2..0: the top snow
    ! layer is at -2, the slot just above it is -3, and index 0 is ordinary bottom snow
    ! rather than moss. Everything shifts down one slot and the expected difference is
    ! unchanged, which is the guard that the reindexed lower bound still reduces to the
    ! stock snl+1.
    class(TestTWAH), intent(inout) :: this
    ! The layer count the column carries; the routine only reads it.
    integer, parameter :: snl = -3
    ! jbot_sno is 0 on a stock column, so the sum's lower bound is snl+1 and
    ! get_jbot_snow puts the pack's bottom slot at the soil surface, where the sum's
    ! fixed upper bound of 0 already ended. j_above is the empty slot just above the
    ! pack, which the sum must not reach.
    integer, parameter :: jtop = snl + 1
    integer, parameter :: jbot = 0
    integer, parameter :: j_above = jtop - 1
    integer :: num_c, c
    integer, allocatable :: filter_c(:)
    real(r8) :: liquid_base(1), ice_base(1)
    real(r8) :: liquid_mass(1), ice_mass(1)

    call this%setupColumn(snl = snl, jbot_sno = 0)
    call filter_from_range(bounds%begc, bounds%endc, num_c, filter_c)
    c = bounds%begc
    liquid_base(:) = 0._r8
    ice_base(:) = 0._r8
    liquid_mass(:) = 0._r8
    ice_mass(:) = 0._r8

    associate(ws => this%water_inst%waterstatebulk_inst)
    call ComputeLiqIceMassNonLake(bounds, num_c, filter_c, &
         ws, this%water_inst%waterdiagnosticbulk_inst, &
         subtract_dynbal_baselines = .false., &
         liquid_mass = liquid_base, ice_mass = ice_base)

    ws%h2osoi_ice_col(c,j_above) = ice_above
    ws%h2osoi_liq_col(c,j_above) = liq_above
    ws%h2osoi_ice_col(c,jtop) = ice_top
    ws%h2osoi_liq_col(c,jtop) = liq_top
    ws%h2osoi_ice_col(c,jbot) = ice_zero
    ws%h2osoi_liq_col(c,jbot) = liq_zero

    call ComputeLiqIceMassNonLake(bounds, num_c, filter_c, &
         ws, this%water_inst%waterdiagnosticbulk_inst, &
         subtract_dynbal_baselines = .false., &
         liquid_mass = liquid_mass, ice_mass = ice_mass)
    end associate

    @assertEqual(ice_top + ice_zero, ice_mass(c) - ice_base(c), tolerance=tol)
    @assertEqual(liq_top + liq_zero, liquid_mass(c) - liquid_base(c), tolerance=tol)
  end subroutine ComputeLiqIceMass_stock

end module test_total_water_and_heat
