module test_SnowHydrology_divideSnowLayers

  ! Tests of SnowHydrologyMod: DivideSnowLayers

  ! DivideSnowLayers subdivides any snow layer that has grown past its maximum allowed
  ! thickness. It does the work on copies: the pack is read out of the column arrays into
  ! temporary 1-based arrays (dzsno, swice, swliq, tsno, the aerosol masses and rds)
  ! running 1..msno from the top layer down, subdivided there, then written back. These
  ! tests call those temporaries the "staging" arrays, the read-out the "staging map",
  ! and the write-back "its inverse".
  !
  ! Terms used below. A "slot" is one index of the column arrays in -nlevsno+1 .. 0,
  ! whether or not a snow layer occupies it. The "pack" is the run of slots that do hold
  ! snow, jtop .. jbot, short for col%get_jtop_snow(c) .. col%get_jbot_snow(c). On an NVP
  ! column (jbot_sno == -1) the pack is snl .. -1 and slot 0 is the "moss slot", which is
  ! not snow and which snow code must never touch; on a stock column (jbot_sno == 0) the
  ! pack is snl+1 .. 0 and there is no moss slot. The "anchor" is zi(c,jbot), the
  ! interface at the bottom of the pack: the interface recursion at the end of the
  ! routine reads it and works upward from it, and must never write it. That is the soil
  ! surface zi(c,0) = 0 on a stock column and the top of the moss, zi(c,-1), on an NVP
  ! one.
  !
  ! The NVP changes are:
  ! 1. The staging map, its inverse, and the interface recursion key off jtop/jbot instead
  !    of snl+1 and 0, and
  ! 2. The pack is capped at nlevsno-1 layers because the moss occupies one of the nlevsno
  !    slots.
  !
  ! With nlevsno = 5 and the values SnowHydrologySetControlForTesting pins, the
  ! thresholds InitSnowLayers builds, indexed by staging position k = 1..5, are
  !   dzmax_u = 0.02, 0.05, 0.11, 0.23, huge   (max thickness with layers beneath)
  !   dzmax_l = 0.03, 0.07, 0.18, 0.41, huge   (max thickness with nothing beneath)
  ! A bottom layer thicker than dzmax_l(k) is halved into two; a layer with something
  ! beneath it that is thicker than dzmax_u(k) sheds the excess into the layer below.
  ! Both comparisons are a strict ">", so a thickness exactly equal to a threshold does
  ! nothing. What the thresholds are compared against is not dz itself: for snow layers
  ! dz is the thickness within the snow-covered fraction, and the staging map multiplies
  ! it by frac_sno_eff to get the grid-cell-average thickness the table is stated in
  ! (SnowHydrologyMod.F90:1357). These tests pin frac_sno_eff = 0.5, so every dz_layers
  ! value below stages at half its value, and it is those halves that each test's
  ! dz_layers are chosen against.

  use funit
  use SnowHydrologyMod, only : DivideSnowLayers, InitSnowLayers
  use SnowHydrologyMod, only : SnowHydrologySetControlForTesting, SnowHydrologyClean
  use shr_kind_mod, only : r8 => shr_kind_r8
  use unittestSubgridMod
  use unittestSimpleSubgridSetupsMod, only : setup_single_veg_patch
  use unittestFilterBuilderMod, only : filter_from_range
  use unittestWaterTypeFactory, only : unittest_water_type_factory_type
  use AerosolMod, only : aerosol_type
  use TemperatureType, only : temperature_type
  use WaterType, only : water_type
  use ColumnType, only : col
  use clm_varpar, only : nlevsno, nlevgrnd

  implicit none

  @TestCase
  type, extends(TestCase) :: TestDivide
     type(unittest_water_type_factory_type) :: water_factory
     type(water_type) :: water_inst
     type(temperature_type) :: temperature_inst
     type(aerosol_type) :: aerosol_inst
     integer :: num_snowc
     integer, allocatable :: filter_snowc(:)
   contains
     procedure :: setUp
     procedure :: tearDown
     procedure :: setupColumn
     procedure :: assertSlotUnchanged
     procedure :: assertMossUntouched
     procedure :: totalIce
     procedure :: totalLiq
  end type TestDivide

  ! Column shape handed to the water type factory. nlevsno = 5 is what makes the
  ! threshold table in the header above concrete, so the tests depend on it.
  integer, parameter :: my_nlevsoi = 3
  integer, parameter :: nlevgrnd_additional = 1
  integer, parameter :: my_nlevsno = 5

  real(r8), parameter :: tol = 1.e-13_r8

  ! Snow cover fraction. Held below one so that the staging map's multiply by
  ! frac_sno_eff and the write-back's divide by it are not both the identity: at one,
  ! dropping either leg would leave every test here passing. A power of two, so halving
  ! is exact: each staged thickness is bit-identical to the dz the tests used before
  ! frac_sno_eff was pinned, which is what makes doubling every dz_layers value
  ! behaviour-preserving rather than merely close.
  real(r8), parameter :: frac_sno_eff = 0.5_r8

  ! Moss thickness, which would stage at frac_sno_eff*dz_nvp = 0.06, and must stay above
  ! both dzmax_l(1) = 0.03 and dzmax_u(1) = 0.02. If a wrong staging offset ever pulled
  ! the moss slot into the pack, the moss would be halved or made to shed thickness,
  ! which the dz assertions catch; a staged moss thickness under both thresholds would
  ! only be shuffled between slots and could go unnoticed.
  real(r8), parameter :: dz_nvp = 0.12_r8

  ! One scale per staged quantity; see slot_value below for how they are used and what
  ! values they produce.
  real(r8), parameter :: ice_scale = 10._r8
  real(r8), parameter :: liq_scale = 1._r8
  real(r8), parameter :: rds_scale = 50._r8
  real(r8), parameter :: t_base = 260._r8

contains

  pure function slot_value(j, scale) result(val)
    ! Manufactures the value a snow slot starts out holding, and is called again after
    ! the routine has run to say what that slot should still hold.
    !
    ! Every slot gets a different value because the bug these tests hunt is an indexing
    ! error: if all five slots held the same number, a staging map that picked up the
    ! wrong slot would produce identical output and the test would pass. With
    ! nlevsno = 5 the expression below turns the slot index into a small multiplier,
    ! and each quantity applies a different scale to it, so a value landing in the
    ! wrong slot and a value landing in the wrong array are both visible:
    !
    !   slot j              -4    -3    -2    -1     0
    !   multiplier           2     3     4     5     6
    !   ice   (ice_scale)   20    30    40    50    60
    !   liq   (liq_scale)    2     3     4     5     6
    !   rds   (rds_scale)  100   150   200   250   300
    !   t     (t_base + )  262   263   264   265   266
    !
    ! The multiplier starts at 2 rather than 0 so that no marker can be mistaken for a
    ! slot the routine zeroed.
    integer, intent(in) :: j
    real(r8), intent(in) :: scale
    real(r8) :: val

    val = scale * real(j + nlevsno + 1, r8)
  end function slot_value

  pure function aerosol_value(j, species) result(val)
    ! The same idea as slot_value in two dimensions, because the staging carries the
    ! eight aerosol species in eight separate arrays and reindexes each one separately.
    ! The 1e-9 factor puts the markers in the range aerosol masses actually occupy.
    !
    ! The encoding is positional rather than a product: the species index occupies the
    ! units digit and the slot multiplier from slot_value everything above it, so every
    ! (slot, species) pair carries its own value -- distinct in both dimensions at once,
    ! not merely within a fixed species or a fixed slot. Only the species field is
    ! bounded, by species_base, so the property holds for any nlevsno: a larger nlevsno
    ! only widens the slot field, which never reaches the units digit. The smallest
    ! marker is 21e-9, so no marker can be mistaken for a slot the routine zeroed.
    !
    ! Being distinct in both dimensions at once is what makes this a regression test
    ! rather than a description of today's code. A product is symmetric in its two
    ! indices, so a later reindex that transposed slot against species would land on
    ! markers the fixture already expects and pass unnoticed.
    integer, intent(in) :: j
    integer, intent(in) :: species
    real(r8) :: val

    ! Must exceed the largest species index for the two fields to stay separable.
    integer, parameter :: species_base = 10

    val = 1.e-9_r8 * real(species_base * (j + nlevsno + 1) + species, r8)
  end function aerosol_value

  subroutine setUp(this)
    ! Runs before every test: fixes the vertical grid the water type factory will build
    ! on. The subgrid itself, and the temperature and aerosol arrays, are left to
    ! setupColumn, since each test picks its own snl and jbot_sno. tearDown undoes all of
    ! it.
    class(TestDivide), intent(inout) :: this

    ! These components are pointers with no default initialization, so their association
    ! status is undefined until setupColumn allocates them; tearDown's associated()
    ! guards only mean anything once they are nullified here.
    nullify(this%temperature_inst%t_soisno_col)
    nullify(this%aerosol_inst%mss_bcphi_col)
    nullify(this%aerosol_inst%mss_bcpho_col)
    nullify(this%aerosol_inst%mss_ocphi_col)
    nullify(this%aerosol_inst%mss_ocpho_col)
    nullify(this%aerosol_inst%mss_dst1_col)
    nullify(this%aerosol_inst%mss_dst2_col)
    nullify(this%aerosol_inst%mss_dst3_col)
    nullify(this%aerosol_inst%mss_dst4_col)

    call this%water_factory%init()
    call this%water_factory%setup_before_subgrid( &
         my_nlevsoi = my_nlevsoi, &
         nlevgrnd_additional = nlevgrnd_additional, &
         my_nlevsno = my_nlevsno)
  end subroutine setUp

  subroutine tearDown(this)
    ! Runs after every test, including one that failed partway through setupColumn, hence
    ! the associated() guards. SnowHydrologyClean releases the dzmin/dzmax_u/dzmax_l
    ! arrays that setupColumn's InitSnowLayers call allocated, so the next test's
    ! InitSnowLayers can allocate them again.
    class(TestDivide), intent(inout) :: this

    if (associated(this%temperature_inst%t_soisno_col)) then
       deallocate(this%temperature_inst%t_soisno_col)
    end if
    if (associated(this%aerosol_inst%mss_bcphi_col)) then
       deallocate(this%aerosol_inst%mss_bcphi_col)
       deallocate(this%aerosol_inst%mss_bcpho_col)
       deallocate(this%aerosol_inst%mss_ocphi_col)
       deallocate(this%aerosol_inst%mss_ocpho_col)
       deallocate(this%aerosol_inst%mss_dst1_col)
       deallocate(this%aerosol_inst%mss_dst2_col)
       deallocate(this%aerosol_inst%mss_dst3_col)
       deallocate(this%aerosol_inst%mss_dst4_col)
    end if
    call this%water_factory%teardown(this%water_inst)
    call SnowHydrologyClean()
    call unittest_subgrid_teardown()
  end subroutine tearDown

  subroutine setupColumn(this, snl, jbot_sno, dz_layers)
    ! Build the single column every test works on: snl snow layers laid out from jtop
    ! down with the given thicknesses, a distinct marker value in every staged quantity
    ! in every slot, and, where jbot_sno == -1, a moss slot of thickness dz_nvp at
    ! index 0. jbot_sno = -1 makes it an NVP column and 0 a stock one; nothing else
    ! about the setup differs between the two.
    class(TestDivide), intent(inout) :: this
    integer, intent(in) :: snl
    integer, intent(in) :: jbot_sno
    real(r8), intent(in) :: dz_layers(:)  ! snow layer thicknesses, top layer first

    integer :: c, j
    real(r8), allocatable :: no_snow(:)

    call setup_single_veg_patch(pft_type = 1)
    col%jbot_sno(bounds%begc:bounds%endc) = jbot_sno

    ! dzmin/dzmax_u/dzmax_l are allocated in InitSnowLayers and read by
    ! DivideSnowLayers, so InitSnowLayers has to run first; a zero snow depth keeps it
    ! from laying down a pack of its own.
    call SnowHydrologySetControlForTesting()
    allocate(no_snow(bounds%begc:bounds%endc))
    no_snow(:) = 0._r8
    call InitSnowLayers(bounds, no_snow)

    call this%water_factory%setup_after_subgrid(snl = snl, dz = 0.05_r8)
    call this%water_factory%create_water_type(this%water_inst)
    call filter_from_range(bounds%begc, bounds%endc, this%num_snowc, this%filter_snowc)

    allocate(this%temperature_inst%t_soisno_col(bounds%begc:bounds%endc, -nlevsno+1:nlevgrnd))
    allocate(this%aerosol_inst%mss_bcphi_col(bounds%begc:bounds%endc, -nlevsno+1:0))
    allocate(this%aerosol_inst%mss_bcpho_col(bounds%begc:bounds%endc, -nlevsno+1:0))
    allocate(this%aerosol_inst%mss_ocphi_col(bounds%begc:bounds%endc, -nlevsno+1:0))
    allocate(this%aerosol_inst%mss_ocpho_col(bounds%begc:bounds%endc, -nlevsno+1:0))
    allocate(this%aerosol_inst%mss_dst1_col(bounds%begc:bounds%endc, -nlevsno+1:0))
    allocate(this%aerosol_inst%mss_dst2_col(bounds%begc:bounds%endc, -nlevsno+1:0))
    allocate(this%aerosol_inst%mss_dst3_col(bounds%begc:bounds%endc, -nlevsno+1:0))
    allocate(this%aerosol_inst%mss_dst4_col(bounds%begc:bounds%endc, -nlevsno+1:0))

    c = bounds%begc

    associate( &
         ws => this%water_inst%waterstatebulk_inst, &
         wd => this%water_inst%waterdiagnosticbulk_inst)

    ! The staging map multiplies dz by frac_sno_eff and the write-back divides by it, so
    ! it has to be nonzero; see the parameter for why it is not one.
    wd%frac_sno_eff_col(c) = frac_sno_eff

    do j = -nlevsno+1, 0
       this%temperature_inst%t_soisno_col(c,j) = t_base + slot_value(j, 1._r8)
       ws%h2osoi_ice_col(c,j) = slot_value(j, ice_scale)
       ws%h2osoi_liq_col(c,j) = slot_value(j, liq_scale)
       wd%snw_rds_col(c,j) = slot_value(j, rds_scale)
       this%aerosol_inst%mss_bcphi_col(c,j) = aerosol_value(j, 1)
       this%aerosol_inst%mss_bcpho_col(c,j) = aerosol_value(j, 2)
       this%aerosol_inst%mss_ocphi_col(c,j) = aerosol_value(j, 3)
       this%aerosol_inst%mss_ocpho_col(c,j) = aerosol_value(j, 4)
       this%aerosol_inst%mss_dst1_col(c,j) = aerosol_value(j, 5)
       this%aerosol_inst%mss_dst2_col(c,j) = aerosol_value(j, 6)
       this%aerosol_inst%mss_dst3_col(c,j) = aerosol_value(j, 7)
       this%aerosol_inst%mss_dst4_col(c,j) = aerosol_value(j, 8)
    end do

    end associate

    ! zi(c,0) is the soil surface datum on every column. On an NVP column the moss
    ! occupies the interval [-dz_nvp, 0], so its node sits at -dz_nvp/2 and the interface
    ! at its top, zi(c,-1), is the anchor described in the header: the value the
    ! interface recursion starts from and must leave alone.
    col%zi(c,0) = 0._r8
    if (jbot_sno == -1) then
       col%dz(c,0) = dz_nvp
       col%z(c,0) = -0.5_r8 * dz_nvp
       col%zi(c,-1) = -dz_nvp
    end if

    ! dz_layers is given top layer first, and the pack starts at jtop, which is snl on an
    ! NVP column and snl+1 on a stock one. So the same dz_layers describes the same
    ! layers in both cases, just one slot apart.
    do j = 1, size(dz_layers)
       col%dz(c, col%get_jtop_snow(c) + j - 1) = dz_layers(j)
    end do
  end subroutine setupColumn

  function totalIce(this, jtop) result(total)
    ! Ice summed from slot jtop down to the bottom of the pack. The top of the range is
    ! an argument instead of being read back from snl(c) so that it covers exactly the
    ! slots the test expects the pack to occupy: if DivideSnowLayers grew the pack
    ! further than it should have, the extra layer sits above jtop, falls outside this
    ! sum, and shows up as a mass-conservation failure. Deriving the range from the new
    ! snl(c) would have widened it to include that layer and hidden the error.
    class(TestDivide), intent(in) :: this
    integer, intent(in) :: jtop
    real(r8) :: total

    integer :: c, j

    c = bounds%begc
    total = 0._r8
    do j = jtop, col%get_jbot_snow(c)
       total = total + this%water_inst%waterstatebulk_inst%h2osoi_ice_col(c,j)
    end do
  end function totalIce

  function totalLiq(this, jtop) result(total)
    ! Liquid water counterpart of totalIce; see the note on the range there.
    class(TestDivide), intent(in) :: this
    integer, intent(in) :: jtop
    real(r8) :: total

    integer :: c, j

    c = bounds%begc
    total = 0._r8
    do j = jtop, col%get_jbot_snow(c)
       total = total + this%water_inst%waterstatebulk_inst%h2osoi_liq_col(c,j)
    end do
  end function totalLiq

  subroutine assertSlotUnchanged(this, j)
    ! Assert that slot j still holds exactly what setupColumn put there, in every
    ! quantity the staging arrays carry: ice, liquid, temperature, snow grain radius and
    ! all eight aerosol species. Checking the whole set matters because the staging map
    ! reindexes each of them separately, so one of them can be offset while the rest are
    ! right.
    class(TestDivide), intent(in) :: this
    integer, intent(in) :: j

    integer :: c
    real(r8) :: ice, liq, t, rds
    real(r8) :: aerosols(8)

    c = bounds%begc
    ice = this%water_inst%waterstatebulk_inst%h2osoi_ice_col(c,j)
    liq = this%water_inst%waterstatebulk_inst%h2osoi_liq_col(c,j)
    t = this%temperature_inst%t_soisno_col(c,j)
    rds = this%water_inst%waterdiagnosticbulk_inst%snw_rds_col(c,j)
    aerosols(1) = this%aerosol_inst%mss_bcphi_col(c,j)
    aerosols(2) = this%aerosol_inst%mss_bcpho_col(c,j)
    aerosols(3) = this%aerosol_inst%mss_ocphi_col(c,j)
    aerosols(4) = this%aerosol_inst%mss_ocpho_col(c,j)
    aerosols(5) = this%aerosol_inst%mss_dst1_col(c,j)
    aerosols(6) = this%aerosol_inst%mss_dst2_col(c,j)
    aerosols(7) = this%aerosol_inst%mss_dst3_col(c,j)
    aerosols(8) = this%aerosol_inst%mss_dst4_col(c,j)

    @assertEqual(slot_value(j, ice_scale), ice, tolerance=tol)
    @assertEqual(slot_value(j, liq_scale), liq, tolerance=tol)
    @assertEqual(t_base + slot_value(j, 1._r8), t, tolerance=tol)
    @assertEqual(slot_value(j, rds_scale), rds, tolerance=tol)
    @assertEqual(aerosol_value(j, 1), aerosols(1))
    @assertEqual(aerosol_value(j, 2), aerosols(2))
    @assertEqual(aerosol_value(j, 3), aerosols(3))
    @assertEqual(aerosol_value(j, 4), aerosols(4))
    @assertEqual(aerosol_value(j, 5), aerosols(5))
    @assertEqual(aerosol_value(j, 6), aerosols(6))
    @assertEqual(aerosol_value(j, 7), aerosols(7))
    @assertEqual(aerosol_value(j, 8), aerosols(8))
  end subroutine assertSlotUnchanged

  subroutine assertMossUntouched(this)
    ! Assert that the moss slot came through the call intact: its geometry (thickness,
    ! node depth, and the interfaces at its top and bottom, the top one being the anchor)
    ! and every staged quantity in slot 0. Any bound that treated slot 0 as snow -- a
    ! staging offset short by one, a write-back that ran past jbot, or an interface
    ! recursion that stepped down to j = 0 -- fails one of these.
    class(TestDivide), intent(in) :: this

    integer :: c

    c = bounds%begc
    @assertEqual(dz_nvp, col%dz(c,0), tolerance=tol)
    @assertEqual(-0.5_r8*dz_nvp, col%z(c,0), tolerance=tol)
    @assertEqual(-dz_nvp, col%zi(c,-1), tolerance=tol)
    @assertEqual(0._r8, col%zi(c,0), tolerance=tol)
    call this%assertSlotUnchanged(0)
  end subroutine assertMossUntouched

  @Test
  subroutine divide_roundTrip_nvp(this)
    ! On an NVP column whose snow layers are all under their subdivision thresholds,
    ! DivideSnowLayers must be the identity: every quantity returns to the slot it came
    ! from, the layer count is unchanged, and the moss slot is never staged at all.
    !
    ! Three snow layers on an NVP column, so the pack runs -3..-1 and slot 0 is moss.
    ! Nothing is over threshold: dz 0.02 stages in staging slot 1 as 0.01 < dzmax_u(1) =
    ! 0.02, dz 0.06 stages in slot 2 as 0.03 < dzmax_u(2) = 0.05, and the bottom dz 0.2
    ! stages in slot 3 as 0.1 < dzmax_l(3) = 0.18. So the routine must copy the pack out to the
    ! staging arrays and write it back with every value returning to the slot it came
    ! from, and must never stage the moss slot at all.
    !
    ! A staging offset that was off by one would show up here as a slot holding its
    ! neighbour's marker value, or as moss values appearing in the pack -- the marker
    ! values exist so that this is not a no-op test.
    class(TestDivide), intent(inout) :: this
    real(r8), parameter :: dz_layers(3) = [0.02_r8, 0.06_r8, 0.2_r8]
    integer :: j

    call this%setupColumn(snl = -3, jbot_sno = -1, dz_layers = dz_layers)

    call DivideSnowLayers(bounds, this%num_snowc, this%filter_snowc, &
         this%aerosol_inst, this%temperature_inst, this%water_inst, is_lake = .false.)

    @assertEqual(-3, col%snl(bounds%begc))
    do j = -3, -1
       @assertEqual(dz_layers(j+4), col%dz(bounds%begc,j), tolerance=tol)
       call this%assertSlotUnchanged(j)
    end do
    call this%assertMossUntouched()
  end subroutine divide_roundTrip_nvp

  @Test
  subroutine divide_roundTrip_stock(this)
    ! On a stock column whose snow layers are all under their subdivision thresholds,
    ! DivideSnowLayers must be the identity over a pack that ends at the soil surface,
    ! confirming the reindexed staging map reduces to the stock one where no moss slot
    ! exists.
    !
    ! The same three layers and the same thicknesses on a stock column, where jbot_sno is
    ! 0 and the pack sits one slot lower, at -2..0. The thresholds are unchanged because
    ! they are indexed by staging position, not by column index, so again nothing
    ! divides. This is the guard that the reindexed staging map still reduces to the
    ! stock one where there is no moss slot.
    class(TestDivide), intent(inout) :: this
    real(r8), parameter :: dz_layers(3) = [0.02_r8, 0.06_r8, 0.2_r8]
    integer :: j

    call this%setupColumn(snl = -3, jbot_sno = 0, dz_layers = dz_layers)

    call DivideSnowLayers(bounds, this%num_snowc, this%filter_snowc, &
         this%aerosol_inst, this%temperature_inst, this%water_inst, is_lake = .false.)

    @assertEqual(-3, col%snl(bounds%begc))
    do j = -2, 0
       @assertEqual(dz_layers(j+3), col%dz(bounds%begc,j), tolerance=tol)
       call this%assertSlotUnchanged(j)
    end do
  end subroutine divide_roundTrip_stock

  @Test
  subroutine divide_subdivides_nvp(this)
    ! An NVP column's only snow layer, thicker than a bottom layer is allowed to be, must
    ! split into two that grow upward away from the moss, conserving ice and liquid and
    ! leaving the moss thickness and the interface the pack sits on untouched.
    !
    ! One snow layer of dz 0.08 m on an NVP column, staging at 0.04, so the pack is the
    ! single slot -1 and the moss is at 0. As the bottom layer it is measured against
    ! dzmax_l(1) = 0.03 and exceeds it, so it is halved into two layers staging at 0.02,
    ! dz 0.04; 0.02 is not greater than dzmax_u(1) = 0.02, so the upper half then sheds
    ! nothing into the lower and the pack settles at -2..-1.
    !
    ! The new layer has to appear above the old one. If the pack grew downward instead it
    ! would land on the moss, so the assertions pin dz(c,0) and the zi(c,-1) anchor as
    ! well as conservation of ice and liquid. The final loop walks the interface
    ! recursion the routine rebuilt, checking that each interface and node depth follows
    ! from the one below it, which only holds if the recursion started at the anchor
    ! rather than at zi(c,0).
    class(TestDivide), intent(inout) :: this
    real(r8), parameter :: dz_layers(1) = [0.08_r8]
    real(r8) :: ice_before, liq_before
    integer :: c, j

    call this%setupColumn(snl = -1, jbot_sno = -1, dz_layers = dz_layers)
    c = bounds%begc
    ice_before = this%totalIce(jtop = -1)
    liq_before = this%totalLiq(jtop = -1)

    call DivideSnowLayers(bounds, this%num_snowc, this%filter_snowc, &
         this%aerosol_inst, this%temperature_inst, this%water_inst, is_lake = .false.)

    @assertEqual(-2, col%snl(c))
    @assertEqual(ice_before, this%totalIce(jtop = -2), tolerance=tol)
    @assertEqual(liq_before, this%totalLiq(jtop = -2), tolerance=tol)
    @assertEqual(dz_nvp, col%dz(c,0), tolerance=tol)
    @assertEqual(-dz_nvp, col%zi(c,-1), tolerance=tol)
    do j = -1, -2, -1
       @assertEqual(col%zi(c,j-1), col%zi(c,j) - col%dz(c,j), tolerance=tol)
       @assertEqual(col%z(c,j), col%zi(c,j) - 0.5_r8*col%dz(c,j), tolerance=tol)
    end do
  end subroutine divide_subdivides_nvp

  @Test
  subroutine divide_capsAtNlevsnoMinusOne_nvp(this)
    ! An NVP pack already holding as many layers as the moss slot leaves room for must
    ! refuse to divide even with its bottom layer far over the limit, because one more
    ! layer would start the pack below the first index the column arrays have.
    !
    ! An NVP pack already at its capacity: nlevsno-1 = 4 layers running -4..-1, with the
    ! moss at 0. The dz 2 m bottom layer stages at 1 m, far over dzmax_l(4) = 0.41, and
    ! would divide if the routine let it, but the loop over staging positions stops at
    ! k < nlevsno-1 on an NVP column, so it never reaches that layer. Nothing divides:
    ! snl, the moss slot, and every staged quantity in all four pack slots come back as
    ! they went in.
    !
    ! Growing to nlevsno layers here would be worse than merely wrong bookkeeping. The
    ! pack would then start at snl+1+jbot_sno = -nlevsno, one slot below the -nlevsno+1
    ! lower bound of the column arrays, so the write-back loop would simply never visit
    ! the top staging slot and that layer's thickness, ice, liquid and temperature would
    ! be dropped without a trace.
    class(TestDivide), intent(inout) :: this
    real(r8), parameter :: dz_layers(4) = [0.02_r8, 0.06_r8, 0.2_r8, 2._r8]
    real(r8) :: ice_before, liq_before
    integer :: c, j

    call this%setupColumn(snl = -(my_nlevsno-1), jbot_sno = -1, dz_layers = dz_layers)
    c = bounds%begc
    ice_before = this%totalIce(jtop = -(my_nlevsno-1))
    liq_before = this%totalLiq(jtop = -(my_nlevsno-1))

    call DivideSnowLayers(bounds, this%num_snowc, this%filter_snowc, &
         this%aerosol_inst, this%temperature_inst, this%water_inst, is_lake = .false.)

    @assertEqual(-(my_nlevsno-1), col%snl(c))
    @assertEqual(ice_before, this%totalIce(jtop = -(my_nlevsno-1)), tolerance=tol)
    @assertEqual(liq_before, this%totalLiq(jtop = -(my_nlevsno-1)), tolerance=tol)
    do j = -(my_nlevsno-1), -1
       @assertEqual(dz_layers(j+my_nlevsno), col%dz(c,j), tolerance=tol)
       call this%assertSlotUnchanged(j)
    end do
    call this%assertMossUntouched()
  end subroutine divide_capsAtNlevsnoMinusOne_nvp

  @Test
  subroutine divide_growsToNlevsnoMinusOne_nvp(this)
    ! An NVP pack one layer short of capacity, with its bottom layer over the limit, must
    ! be allowed to divide and grow upward into the free slot, showing that the cap which
    ! reserves a slot for the moss is no tighter than it needs to be.
    !
    ! The complement of the previous test: the NVP cap is nlevsno-1 and no tighter, so a
    ! pack one layer short of it must still be allowed to divide. Three layers on an NVP
    ! column, pack -3..-1, with a dz 1 m bottom layer staging at 0.5, over
    ! dzmax_l(3) = 0.18. It halves to 0.25 and 0.25; the upper half is then over
    ! dzmax_u(3) = 0.11 and sheds the excess 0.14 into the layer below it, so the pack
    ! ends staged as 0.01, 0.03, 0.11, 0.39 over -4..-1 -- dz 0.02, 0.06, 0.22, 0.78 --
    ! four layers, at the cap, with the staged total 0.54 m preserved.
    !
    ! The pack grows upward into the free slot at -4. A cap that was one layer too tight
    ! would leave snl at -3, and growth downward instead of upward would disturb the moss
    ! slot.
    class(TestDivide), intent(inout) :: this
    real(r8), parameter :: dz_layers(3) = [0.02_r8, 0.06_r8, 1._r8]
    real(r8) :: ice_before, liq_before
    integer :: c

    call this%setupColumn(snl = -3, jbot_sno = -1, dz_layers = dz_layers)
    c = bounds%begc
    ice_before = this%totalIce(jtop = -3)
    liq_before = this%totalLiq(jtop = -3)

    call DivideSnowLayers(bounds, this%num_snowc, this%filter_snowc, &
         this%aerosol_inst, this%temperature_inst, this%water_inst, is_lake = .false.)

    @assertEqual(-(my_nlevsno-1), col%snl(c))
    @assertEqual(ice_before, this%totalIce(jtop = -(my_nlevsno-1)), tolerance=tol)
    @assertEqual(liq_before, this%totalLiq(jtop = -(my_nlevsno-1)), tolerance=tol)
    call this%assertMossUntouched()
  end subroutine divide_growsToNlevsnoMinusOne_nvp

  @Test
  subroutine divide_capsAtNlevsno_stock(this)
    ! A stock column, having no moss slot to reserve, must be allowed to divide its
    ! over-thick bottom layer until snow fills every index the column arrays have,
    ! guarding against the reserved-slot cap leaking onto columns that carry no moss.
    !
    ! The same four layers as divide_capsAtNlevsnoMinusOne_nvp, but on a stock column,
    ! where they sit at -3..0 and the cap is the stock nlevsno = 5. Here the loop does
    ! reach the bottom layer: the dz 2 m layer stages at 1 m, over dzmax_l(4) = 0.41, and
    ! halves to 0.5, the upper half is then over dzmax_u(4) = 0.23 and sheds 0.27 into
    ! the lower, and the pack fills all five slots at -4..0 with its staged 1.14 m total
    ! preserved. This is the guard against applying the nlevsno-1 cap unconditionally
    ! instead of only where the moss slot exists.
    class(TestDivide), intent(inout) :: this
    real(r8), parameter :: dz_layers(4) = [0.02_r8, 0.06_r8, 0.2_r8, 2._r8]
    integer, parameter :: snl_before = -(my_nlevsno-1)
    real(r8) :: ice_before, liq_before
    integer :: c

    call this%setupColumn(snl = snl_before, jbot_sno = 0, dz_layers = dz_layers)
    c = bounds%begc
    ice_before = this%totalIce(jtop = snl_before+1)
    liq_before = this%totalLiq(jtop = snl_before+1)

    call DivideSnowLayers(bounds, this%num_snowc, this%filter_snowc, &
         this%aerosol_inst, this%temperature_inst, this%water_inst, is_lake = .false.)

    @assertEqual(-my_nlevsno, col%snl(c))
    @assertEqual(ice_before, this%totalIce(jtop = -my_nlevsno+1), tolerance=tol)
    @assertEqual(liq_before, this%totalLiq(jtop = -my_nlevsno+1), tolerance=tol)
  end subroutine divide_capsAtNlevsno_stock

end module test_SnowHydrology_divideSnowLayers
