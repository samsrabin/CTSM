module test_SnowHydrology_initSnowLayers
  
  ! Tests of SnowHydrologyMod: initSnowLayers
  
  use funit
  use SnowHydrologyMod
  use shr_kind_mod, only : r8 => shr_kind_r8
  use unittestSubgridMod
  use unittestSimpleSubgridSetupsMod
  use ColumnType, only : col
  use clm_varpar, only : nlevsno

  implicit none
  
  ! How far past the fill-every-level threshold the overfill fixtures sit. Any factor
  ! greater than one overfills, which is what makes the moss slot rather than the depth
  ! the binding constraint on an NVP column's layer count.
  !
  ! Three rather than two, and the reason is a property of the factor rather than of the
  ! vertical structure (i.e., dzmin, dzmax_l and dzmax_u). Once the depth is past the
  ! point where InitSnowLayers would split the bottom two layers evenly, a stock column
  ! that fills every level gets a bottom layer of snow_depth - sum(dzmax_u(1:nlevsno-1));
  ! a factor of exactly two would make that residual equal the very threshold it is
  ! measured from. A bottom layer wrongly assigned that threshold would then still
  ! conserve total thickness, and the conservation assertion would not notice. Lowering
  ! the factor is not free either: it crosses back into the even-split branch just above
  ! one and a half, where this reasoning stops describing what the fixture does. The
  ! crossing sits at 1 + dzmax_u(nlevsno-1)/sum(dzmax_u(1:nlevsno-1)), which falls
  ! towards one and a half from above as nlevsno grows -- 1.56 at an nlevsno of five --
  ! so one and a half itself is already on the even-split side.
  real(r8), parameter :: overfill_factor = 3._r8

  @TestCase
  type, extends(TestCase) :: TestSnowHydrology
   contains
     procedure :: setUp
     procedure :: tearDown
  end type TestSnowHydrology
  
contains
  
  subroutine setUp(this)
    class(TestSnowHydrology), intent(inout) :: this
  end subroutine setUp
  
  subroutine tearDown(this)
    class(TestSnowHydrology), intent(inout) :: this
    call unittest_subgrid_teardown()
    call SnowHydrologyClean()
  end subroutine tearDown

  function overfill_depth() result(depth)
    ! A snow depth that overfills the pack: deeper than any threshold InitSnowLayers can
    ! actually clear, so the pack ends up as many layers deep as the column will hold.
    !
    ! InitSnowLayers grows the layer count while snow_depth exceeds
    ! sum(dzmax_u(1:-snl)), so the deepest threshold it ever compares against is the sum
    ! over 1:nlevsno. But dzmax_u(nlevsno) is set to huge(1._r8), which no snow depth can
    ! exceed, so the deepest threshold a fixture can actually clear is the sum over
    ! 1:nlevsno-1. That is the depth above which a stock column fills every snow level,
    ! and it is why the sum below stops one short of nlevsno. An NVP column runs out of
    ! levels one sooner, so the same depth overfills it with a level to spare.
    ! (The loop that sets dzmax_u(nlevsno) to huge starts at level three, so this
    ! reasoning wants nlevsno of at least three.)
    !
    ! Reading the vertical structure rather than restating a number is the point: the
    ! fixture says "past the fill-every-level threshold" instead of naming a depth that
    ! only happens to be past it today.
    !
    ! dzmin/dzmax_l/dzmax_u are allocated and filled inside InitSnowLayers, so calling it
    ! is the only way to get at the vertical structure. A zero snow depth serves as a bare
    ! allocator: it is below dzmin(1), so every column comes out with an empty pack --
    ! lake columns through their own branch and every other column through the "too
    ! little snow for snowpack existence" one. Either way the snow slots are zeroed, snl
    ! is set to 0 and zi(c,0) is set to 0. That is why callers run this before assigning
    ! any state of their own -- doing it afterwards would leave the fixture's survival
    ! resting on where those blanket assignments happen to stop, which is the very thing
    ! the NVP test exists to pin. The allocates are unguarded, so SnowHydrologyClean()
    ! has to run before the caller's own InitSnowLayers call; that also leaves tearDown's
    ! SnowHydrologyClean balanced.
    !
    ! Expects the caller to have set nlevsno, called SnowHydrologySetControlForTesting to
    ! fill the namelist scalars the vertical structure is built from, and set up the
    ! subgrid so that bounds is valid.
    real(r8) :: depth
    real(r8), allocatable :: no_snow(:)  ! [begc:endc]

    allocate(no_snow(bounds%begc:bounds%endc))
    no_snow(:) = 0._r8
    call InitSnowLayers(bounds, no_snow)
    depth = overfill_factor * sum(dzmax_u(1:nlevsno-1))
    call SnowHydrologyClean()
  end function overfill_depth

  @Test
  subroutine test_initSnowLayers_depth0_snl(this)
    class(TestSnowHydrology), intent(inout) :: this
    real(r8), allocatable :: snow_depth(:)

    ! Setup
    nlevsno = 5
    call SnowHydrologySetControlForTesting()
    call setup_single_veg_patch(pft_type = 1)
    allocate(snow_depth(bounds%begc:bounds%endc))
    snow_depth(:) = 0._r8
    col%zi(bounds%begc:bounds%endc,0) = 0._r8 ! Normally initialized elsewhere (initVerticalMod)

    ! Exercise
    call InitSnowLayers(bounds, snow_depth)

    ! Verify
    @assertEqual(0, col%snl(bounds%begc))

  end subroutine test_initSnowLayers_depth0_snl

  @Test
  subroutine test_initSnowLayers_depth1_snl(this)
    class(TestSnowHydrology), intent(inout) :: this
    real(r8), allocatable :: snow_depth(:)

    ! Setup
    nlevsno = 5
    call SnowHydrologySetControlForTesting()
    call setup_single_veg_patch(pft_type = 1)
    allocate(snow_depth(bounds%begc:bounds%endc))
    snow_depth(:) = 1._r8
    col%zi(bounds%begc:bounds%endc,0) = 0._r8 ! Normally initialized elsewhere (initVerticalMod)

    ! Exercise
    call InitSnowLayers(bounds, snow_depth)

    ! Verify
    @assertEqual(-5, col%snl(bounds%begc))

  end subroutine test_initSnowLayers_depth1_snl

  @Test
  subroutine test_initSnowLayers_overfillPack_stock(this)
    ! On a stock column given snow deep enough to overfill the pack, InitSnowLayers must
    ! lay down a pack whose thicknesses sum to the snow depth and whose node depths and
    ! interfaces close on one another all the way up from the soil surface.
    !
    ! Geometry, not just the layer count. Asserted as invariants rather than literal
    ! thicknesses: SnowHydrologySetControlForTesting does pin the vertical structure
    ! those thicknesses come from, but restating it here would only re-derive that
    ! structure instead of the property the layering has to satisfy.
    !
    ! Complementary to test_initSnowLayers_overfillPack_nvp: the same snow depth and the
    ! same nlevsno, differing only in whether the moss slot is claimed. This one pins
    ! what the geometry has to look like with all nlevsno slots available to snow, so
    ! that whatever differs over there is the moss slot's doing and nothing else.
    class(TestSnowHydrology), intent(inout) :: this
    real(r8), allocatable :: snow_depth(:)  ! [begc:endc]
    integer, parameter :: my_nlevsno = 5
    ! Deep enough that InitSnowLayers fills every snow level; see overfill_depth, which
    ! derives the depth from the vertical structure rather than naming one.
    real(r8) :: total_snow_depth
    ! The most layers a stock column may hold, which an overfilling snow depth takes it
    ! to: no slot is reserved for moss, so snow may fill all nlevsno of them. On a stock
    ! column jbot_sno is 0, so the pack's top slot is snl+1 and get_jbot_snow puts its
    ! bottom slot at the soil surface.
    integer, parameter :: snl_full = -my_nlevsno
    integer, parameter :: jtop = snl_full + 1
    integer, parameter :: jbot = 0
    ! The soil surface datum as this test's setup left it, read back out of the array
    ! instead of being restated as a literal below. The invariant being pinned is that
    ! InitSnowLayers returns the datum it was handed, not that the datum is any
    ! particular number, so the assertion has to follow whatever setup wrote.
    real(r8) :: zi_soil_before
    real(r8), parameter :: tol = 1.e-13_r8
    integer :: c, j

    ! Setup
    nlevsno = my_nlevsno
    call SnowHydrologySetControlForTesting()
    call setup_single_veg_patch(pft_type = 1)
    ! Before anything else this test sets up: overfill_depth makes a throwaway
    ! InitSnowLayers call, which zeroes the snow slots and snl and sets zi(c,0) to 0.
    ! The soil surface datum is still assigned explicitly below, deliberately: without
    ! that line the datum assertion would only be checking that InitSnowLayers preserves
    ! what an earlier InitSnowLayers call wrote.
    total_snow_depth = overfill_depth()
    allocate(snow_depth(bounds%begc:bounds%endc))
    snow_depth(:) = total_snow_depth
    c = bounds%begc
    col%zi(c,0) = 0._r8 ! Normally initialized elsewhere (initVerticalMod)
    zi_soil_before = col%zi(c,0)

    ! Exercise
    call InitSnowLayers(bounds, snow_depth)

    ! Verify
    @assertEqual(snl_full, col%snl(c))
    ! Soil surface datum untouched
    @assertEqual(zi_soil_before, col%zi(c,0))
    ! Thickness conserved
    @assertEqual(total_snow_depth, sum(col%dz(c,jtop:jbot)), tolerance=tol)
    ! Top of the pack a full snow depth above the soil surface
    @assertEqual(-total_snow_depth, col%zi(c,jtop-1), tolerance=tol)
    ! Node at layer midpoint, and the interface recursion closes
    do j = jtop, jbot
       @assertGreaterThan(col%dz(c,j), 0._r8)
       @assertEqual(col%zi(c,j) - 0.5_r8*col%dz(c,j), col%z(c,j), tolerance=tol)
       @assertEqual(col%zi(c,j) - col%dz(c,j), col%zi(c,j-1), tolerance=tol)
    end do

  end subroutine test_initSnowLayers_overfillPack_stock

  @Test
  subroutine test_initSnowLayers_overfillPack_nvp(this)
    ! On an NVP column given snow deep enough to overfill the pack, InitSnowLayers must
    ! cap the layer count at what the moss slot leaves free, rest the pack on top of the
    ! moss rather than on the soil surface, and leave the moss geometry untouched.
    !
    ! With the index-0 slot claimed, snow occupies -4:-1, the layer count is
    ! capped at nlevsno-1, and the moss geometry at slot 0 survives untouched.
    ! This is the case that distinguishes resting the interface recursion on
    ! the snowpack base zi(c,jbot) from the pre-NVP literal -0.5*dz: at
    ! jbot == 0 the two are identical, so only jbot == -1 can catch a
    ! swallowed moss thickness.
    !
    ! The moss node laid down below is deliberately not the midpoint of the moss layer,
    ! which is not where a real moss layer's node would be; see moss_node_fraction. That
    ! is what pins the slot the interface recursion starts from: a loop that began at
    ! slot 0 rather than at jbot would overwrite the node with the layer midpoint, which
    ! is exactly where a physically consistent fixture would already have put it.
    !
    ! Complementary to test_initSnowLayers_overfillPack_stock: the same snow depth and
    ! the same nlevsno, differing only in whether the moss slot is claimed.
    class(TestSnowHydrology), intent(inout) :: this
    real(r8), allocatable :: snow_depth(:)  ! [begc:endc]
    real(r8), parameter :: dz_nvp = 0.02_r8
    ! How far below the top of the moss its node sits, as a fraction of dz_nvp. A real
    ! moss layer would put its node at the layer midpoint; this one deliberately does not,
    ! and that is the only reason the recursion's starting slot can be tested at all. The
    ! recursion is z(c,j) = zi(c,j) - 0.5*dz(c,j) and zi(c,j-1) = zi(c,j) - dz(c,j),
    ! walked upward from jbot: a pass at slot 0 would overwrite the moss node with the
    ! layer midpoint, so a node already sitting at the midpoint could not show that the
    ! pass happened. Worse, any physically consistent moss geometry is a fixed point of
    ! the whole recursion -- zi(c,0) = 0, dz(c,0) = dz_nvp, z(c,0) = -0.5*dz_nvp and
    ! zi(c,-1) = -dz_nvp substituted into it reproduce themselves exactly -- so no
    ! physical fixture could detect the guard at all, however it were asserted over. Any
    ! fraction strictly between zero and one but not one half would do; a quarter keeps
    ! the node inside the moss layer, where a node belongs. InitSnowLayers only ever
    ! writes z(c,0) and never reads it, so the unphysical value feeds back into nothing.
    real(r8), parameter :: moss_node_fraction = 0.25_r8
    integer, parameter :: my_nlevsno = 5
    ! Deep enough to fill every snow level had the moss not claimed one, which is what
    ! makes the cap the thing under test here; see overfill_depth, which derives the
    ! depth from the vertical structure rather than naming one.
    real(r8) :: total_snow_depth
    ! The most layers an NVP column may hold, which an overfilling snow depth takes it
    ! to: the moss has claimed one of the nlevsno slots, so snow may fill only nlevsno-1
    ! of them. On an NVP column jbot_sno is -1, so jtop is snl itself and get_jbot_snow
    ! puts the pack's bottom slot at -1, with the moss just below it at 0.
    integer, parameter :: snl_full = -(my_nlevsno-1)
    integer, parameter :: jtop = snl_full
    integer, parameter :: jbot = -1
    integer, parameter :: j_moss = 0
    ! The moss geometry and the soil surface datum as this test's setup left them, read
    ! back out of the arrays instead of being restated as literals below. The invariant
    ! being pinned is that InitSnowLayers returns all four as it was handed them, not
    ! that they are any particular numbers, so the assertions have to follow whatever
    ! setup wrote.
    real(r8) :: dz_moss_before, z_moss_before, zi_moss_top_before, zi_soil_before
    real(r8), parameter :: tol = 1.e-13_r8
    integer :: c, j

    ! Setup
    nlevsno = my_nlevsno
    call SnowHydrologySetControlForTesting()
    call setup_single_veg_patch(pft_type = 1)
    ! Before anything else this test sets up: overfill_depth makes a throwaway
    ! InitSnowLayers call, which zeroes the snow slots and snl and sets zi(c,0) to 0.
    ! The soil surface datum is still assigned explicitly below, deliberately: without
    ! that line the datum assertion would only be checking that InitSnowLayers preserves
    ! what an earlier InitSnowLayers call wrote.
    total_snow_depth = overfill_depth()
    allocate(snow_depth(bounds%begc:bounds%endc))
    snow_depth(:) = total_snow_depth
    c = bounds%begc
    col%zi(c,0) = 0._r8 ! Normally initialized elsewhere (initVerticalMod)
    ! Stand in for NVPLayerInit, which is what claims the slot in a real run
    col%jbot_sno(c) = -1
    col%dz(c,j_moss) = dz_nvp
    ! Deliberately not the midpoint of the moss layer, which is what makes the slot the
    ! recursion starts from testable: a pass at slot 0 overwrites the node with the
    ! midpoint, and a physically consistent moss geometry -- being a fixed point of that
    ! recursion -- could never show it. See moss_node_fraction.
    col%z(c,j_moss) = -moss_node_fraction * dz_nvp
    col%zi(c,jbot) = -dz_nvp
    dz_moss_before = col%dz(c,j_moss)
    z_moss_before = col%z(c,j_moss)
    zi_moss_top_before = col%zi(c,jbot)
    zi_soil_before = col%zi(c,0)

    ! Exercise
    call InitSnowLayers(bounds, snow_depth)

    ! Verify
    ! capped at nlevsno-1
    @assertEqual(snl_full, col%snl(c))
    ! Literal anchors, so that the fixture itself stays pinned. The captures follow
    ! whatever setup wrote, and overfill_depth's throwaway call has already zeroed slot 0
    ! by the time setup reaches it, so a moss assignment that went missing would leave
    ! the survival assertions below comparing zero to zero. zi(c,jbot) needs no anchor of
    ! its own: the pack-top assertion further down still names dz_nvp outright.
    @assertEqual(dz_nvp, dz_moss_before)
    @assertEqual(-moss_node_fraction*dz_nvp, z_moss_before)
    ! moss geometry survived
    @assertEqual(dz_moss_before, col%dz(c,j_moss))
    @assertEqual(z_moss_before, col%z(c,j_moss))
    @assertEqual(zi_moss_top_before, col%zi(c,jbot))
    @assertEqual(zi_soil_before, col%zi(c,0))
    ! snow thickness conserved
    @assertEqual(total_snow_depth, sum(col%dz(c,jtop:jbot)), tolerance=tol)
    ! Top of the pack sits a full snow depth above the moss, not above the soil
    ! surface: this is the assertion that fails if the snowpack base drops dz_nvp.
    @assertEqual(-(dz_nvp + total_snow_depth), col%zi(c,jtop-1), tolerance=tol)
    do j = jtop, jbot
       @assertGreaterThan(col%dz(c,j), 0._r8)
       @assertEqual(col%zi(c,j) - 0.5_r8*col%dz(c,j), col%z(c,j), tolerance=tol)
       @assertEqual(col%zi(c,j) - col%dz(c,j), col%zi(c,j-1), tolerance=tol)
    end do

  end subroutine test_initSnowLayers_overfillPack_nvp

end module test_SnowHydrology_initSnowLayers
