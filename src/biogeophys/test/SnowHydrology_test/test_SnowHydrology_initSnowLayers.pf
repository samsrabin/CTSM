module test_SnowHydrology_initSnowLayers
  
  ! Tests of SnowHydrologyMod: initSnowLayers
  
  use funit
  use SnowHydrologyMod
  use shr_kind_mod, only : r8 => shr_kind_r8
  use unittestSubgridMod
  use unittestSimpleSubgridSetupsMod
  use ColumnType, only : col
  use clm_varpar, only : nlevsno

  implicit none
  
  @TestCase
  type, extends(TestCase) :: TestSnowHydrology
   contains
     procedure :: setUp
     procedure :: tearDown
  end type TestSnowHydrology
  
contains
  
  subroutine setUp(this)
    class(TestSnowHydrology), intent(inout) :: this
  end subroutine setUp
  
  subroutine tearDown(this)
    class(TestSnowHydrology), intent(inout) :: this
    call unittest_subgrid_teardown()
    call SnowHydrologyClean()
  end subroutine tearDown

  @Test
  subroutine test_initSnowLayers_depth0_snl(this)
    class(TestSnowHydrology), intent(inout) :: this
    real(r8), allocatable :: snow_depth(:)

    ! Setup
    nlevsno = 5
    call SnowHydrologySetControlForTesting()
    call setup_single_veg_patch(pft_type = 1)
    allocate(snow_depth(bounds%begc:bounds%endc))
    snow_depth(:) = 0._r8
    col%zi(bounds%begc:bounds%endc,0) = 0._r8 ! Normally initialized elsewhere (initVerticalMod)

    ! Exercise
    call InitSnowLayers(bounds, snow_depth)

    ! Verify
    @assertEqual(0, col%snl(bounds%begc))

  end subroutine test_initSnowLayers_depth0_snl

  @Test
  subroutine test_initSnowLayers_depth1_snl(this)
    class(TestSnowHydrology), intent(inout) :: this
    real(r8), allocatable :: snow_depth(:)

    ! Setup
    nlevsno = 5
    call SnowHydrologySetControlForTesting()
    call setup_single_veg_patch(pft_type = 1)
    allocate(snow_depth(bounds%begc:bounds%endc))
    snow_depth(:) = 1._r8
    col%zi(bounds%begc:bounds%endc,0) = 0._r8 ! Normally initialized elsewhere (initVerticalMod)

    ! Exercise
    call InitSnowLayers(bounds, snow_depth)

    ! Verify
    @assertEqual(-5, col%snl(bounds%begc))

  end subroutine test_initSnowLayers_depth1_snl

  @Test
  subroutine test_initSnowLayers_depth1_geometry(this)
    ! Geometry, not just the layer count: dz/z/zi must satisfy the layering
    ! invariants. Asserted as invariants rather than literal thicknesses:
    ! SnowHydrologySetControlForTesting does pin the dzmax_u schedule those
    ! thicknesses come from, but restating it here would only re-derive the
    ! schedule instead of the property the layering has to satisfy.
    class(TestSnowHydrology), intent(inout) :: this
    real(r8), allocatable :: snow_depth(:)
    integer :: c, j

    ! Setup
    nlevsno = 5
    call SnowHydrologySetControlForTesting()
    call setup_single_veg_patch(pft_type = 1)
    allocate(snow_depth(bounds%begc:bounds%endc))
    snow_depth(:) = 1._r8
    col%zi(bounds%begc:bounds%endc,0) = 0._r8 ! Normally initialized elsewhere (initVerticalMod)

    ! Exercise
    call InitSnowLayers(bounds, snow_depth)

    ! Verify
    c = bounds%begc
    @assertEqual(-5, col%snl(c))
    ! Soil surface datum untouched
    @assertEqual(0._r8, col%zi(c,0))
    ! Thickness conserved
    @assertEqual(1._r8, sum(col%dz(c,-4:0)), tolerance=1.e-13_r8)
    ! Pack bottom at -snow_depth
    @assertEqual(-1._r8, col%zi(c,-5), tolerance=1.e-13_r8)
    ! Node at layer midpoint, and the interface recursion closes
    do j = -4, 0
       @assertGreaterThan(col%dz(c,j), 0._r8)
       @assertEqual(col%zi(c,j) - 0.5_r8*col%dz(c,j), col%z(c,j), tolerance=1.e-13_r8)
       @assertEqual(col%zi(c,j) - col%dz(c,j), col%zi(c,j-1), tolerance=1.e-13_r8)
    end do

  end subroutine test_initSnowLayers_depth1_geometry

  @Test
  subroutine test_initSnowLayers_depth1_nvp(this)
    ! The NVP case: with the index-0 slot claimed, snow occupies -4:-1, the
    ! layer count is capped at nlevsno-1, and the moss geometry at slot 0
    ! survives untouched. This is the case that distinguishes anchoring the
    ! recursion at zi(c,jbot) from the stock literal -0.5*dz: at jbot == 0 the
    ! two are identical, so only jbot == -1 can catch a swallowed moss
    ! thickness.
    class(TestSnowHydrology), intent(inout) :: this
    real(r8), allocatable :: snow_depth(:)
    real(r8), parameter :: dz_nvp = 0.02_r8
    integer :: c, j

    ! Setup
    nlevsno = 5
    call SnowHydrologySetControlForTesting()
    call setup_single_veg_patch(pft_type = 1)
    allocate(snow_depth(bounds%begc:bounds%endc))
    snow_depth(:) = 1._r8
    c = bounds%begc
    col%zi(c,0) = 0._r8      ! Normally initialized elsewhere (initVerticalMod)
    ! Stand in for NVPLayerInit, which is what claims the slot in a real run
    col%jbot_sno(c) = -1
    col%dz(c,0)     = dz_nvp
    col%z(c,0)      = -0.5_r8 * dz_nvp
    col%zi(c,-1)    = -dz_nvp

    ! Exercise
    call InitSnowLayers(bounds, snow_depth)

    ! Verify
    ! capped at nlevsno-1
    @assertEqual(-4, col%snl(c))
    ! moss geometry survived
    @assertEqual(dz_nvp, col%dz(c,0))
    @assertEqual(-0.5_r8*dz_nvp, col%z(c,0))
    @assertEqual(-dz_nvp, col%zi(c,-1))
    @assertEqual(0._r8, col%zi(c,0))
    ! snow thickness conserved
    @assertEqual(1._r8, sum(col%dz(c,-4:-1)), tolerance=1.e-13_r8)
    ! Pack bottom sits below the moss, not at -snow_depth: this is the
    ! assertion that fails if the snowpack base drops dz_nvp.
    @assertEqual(-(dz_nvp + 1._r8), col%zi(c,-5), tolerance=1.e-13_r8)
    do j = -4, -1
       @assertGreaterThan(col%dz(c,j), 0._r8)
       @assertEqual(col%zi(c,j) - 0.5_r8*col%dz(c,j), col%z(c,j), tolerance=1.e-13_r8)
       @assertEqual(col%zi(c,j) - col%dz(c,j), col%zi(c,j-1), tolerance=1.e-13_r8)
    end do

  end subroutine test_initSnowLayers_depth1_nvp

end module test_SnowHydrology_initSnowLayers
