module test_SnowHydrology_postPercolation

  ! Tests of SnowHydrologyMod: PostPercolation_AdjustLayerThicknesses

  ! PostPercolation_AdjustLayerThicknesses grows any snow layer whose water content
  ! implies more thickness than the layer has: for each slot in the pack it sets
  ! dz = max(dz, h2osoi_liq/denh2o + h2osoi_ice/denice). Slots outside the pack are not
  ! visited at all.
  !
  ! Terms used below. A "slot" is one index of the column arrays in -nlevsno+1 .. 0,
  ! whether or not a snow layer occupies it. The "pack" is the run of slots that do hold
  ! snow, jtop .. jbot, short for col%get_jtop_snow(c) .. col%get_jbot_snow(c). On an NVP
  ! column (jbot_sno == -1) the pack is snl .. -1 and slot 0 is the "moss slot", which is
  ! not snow; on a stock column (jbot_sno == 0) the pack is snl+1 .. 0 and index 0 is
  ! ordinary bottom snow.
  !
  ! The NVP change is just that loop range: jtop .. jbot instead of snl+1 .. 0. The two
  ! tests below use identical dz and h2osoi_liq arrays and identical snl, and differ only
  ! in jbot_sno, so the pack shifts down by one slot between them. That makes the pair
  ! pin both ends of the range at once: a slot excluded in one test is included in the
  ! other.

  use funit
  use SnowHydrologyMod, only : PostPercolation_AdjustLayerThicknesses
  use shr_kind_mod, only : r8 => shr_kind_r8
  use unittestSubgridMod
  use unittestSimpleSubgridSetupsMod, only : setup_single_veg_patch
  use unittestFilterBuilderMod, only : filter_from_range
  use ColumnType, only : col
  use clm_varcon, only : denh2o
  use clm_varpar, only : nlevsno

  implicit none

  @TestCase
  type, extends(TestCase) :: TestPostPercolation
   contains
     procedure :: setUp
     procedure :: tearDown
  end type TestPostPercolation

  integer, parameter :: my_nlevsno = 5

  real(r8), parameter :: tol = 1.e-13_r8

  ! A thin layer paired with liquid that implies more thickness than it has:
  ! liq_over/denh2o = 20/1000 = 0.02 m against dz_thin = 0.01 m. Inside the pack the
  ! max() must double it to 0.02; outside the pack it must stay at 0.01.
  real(r8), parameter :: dz_thin = 0.01_r8
  real(r8), parameter :: liq_over = 20._r8

  ! A layer whose liquid implies less thickness than it has: liq_under/denh2o = 0.01 m
  ! against dz_thick = 0.05 m. The max() leaves this one at 0.05 even inside the pack,
  ! which is what distinguishes "was skipped" from "was visited and left alone".
  real(r8), parameter :: dz_thick = 0.05_r8
  real(r8), parameter :: liq_under = 10._r8

  ! Moss thickness paired with moss liquid far in excess of it: liq_nvp/denh2o = 0.1 m is
  ! five times dz_nvp = 0.02 m. On an NVP column index 0 is outside the pack and must
  ! keep 0.02 however much water sits there, while on a stock column the same slot is
  ! bottom snow and must grow to 0.1. The gap between the two answers is what lets the
  ! two tests tell each other apart.
  real(r8), parameter :: dz_nvp = 0.02_r8
  real(r8), parameter :: liq_nvp = 100._r8

contains

  subroutine setUp(this)
    ! The routine under test takes its arrays as arguments rather than reaching into a
    ! water type, so no water factory is needed here; only nlevsno has to agree with the
    ! bounds the tests declare on their local arrays.
    class(TestPostPercolation), intent(inout) :: this

    nlevsno = my_nlevsno
  end subroutine setUp

  subroutine tearDown(this)
    ! Each test builds its own subgrid, so each one has to be torn down.
    class(TestPostPercolation), intent(inout) :: this

    call unittest_subgrid_teardown()
  end subroutine tearDown

  @Test
  subroutine postPercolation_nvp(this)
    ! On an NVP column, PostPercolation_AdjustLayerThicknesses must thicken every snow
    ! layer whose water implies more thickness than the layer has, and must leave both
    ! the empty slots above the pack and the moss slot below it at the thicknesses they
    ! came in with.
    !
    ! An NVP column with snl = -3, so the pack runs -3..-1 and slot 0 is moss. The five
    ! slots are laid out so that every distinction is exercised at once: -4 is a
    ! thin/over pair above the pack, -3 and -1 are thin/over pairs inside it, -2 is a
    ! thick/under pair inside it, and 0 is the moss with far more water than thickness.
    ! Ice is zero throughout, so only the liquid term of the max() is in play.
    !
    ! Expected: -3 and -1 grow to liq_over/denh2o = 0.02; -2 stays at 0.05 because its
    ! own thickness already covers its water; -4 and 0 keep what they came in with
    ! because the routine never visits them. Stock bounds would run -2..0 instead, which
    ! would leave -3 unadjusted and inflate the moss thickness to 0.1.
    class(TestPostPercolation), intent(inout) :: this
    ! The layer count the column carries throughout; the routine never changes it.
    integer, parameter :: snl = -3
    ! jtop = snl+1+jbot_sno, and jbot_sno is -1 on an NVP column, so the pack's top slot
    ! is snl itself. get_jbot_snow is jbot_sno, so the pack ends at -1 and the moss slot
    ! sits just below it at 0, outside the pack.
    integer, parameter :: jtop = snl
    integer, parameter :: jbot = -1
    integer, parameter :: j_moss = 0
    integer :: num_snowc
    integer, allocatable :: filter_snowc(:)
    real(r8) :: h2osoi_ice(1,-my_nlevsno+1:0)
    real(r8) :: h2osoi_liq(1,-my_nlevsno+1:0)
    real(r8) :: dz(1,-my_nlevsno+1:0)

    call setup_single_veg_patch(pft_type = 1)
    call filter_from_range(bounds%begc, bounds%endc, num_snowc, filter_snowc)
    col%snl(bounds%begc:bounds%endc) = snl
    col%jbot_sno(bounds%begc:bounds%endc) = -1

    ! Array constructors fill the second dimension from its lower bound, so the elements
    ! below are slots -4, -3, -2, -1, 0 in that order.
    h2osoi_ice(:,:) = 0._r8
    dz(1,:) = [dz_thin, dz_thin, dz_thick, dz_thin, dz_nvp]
    h2osoi_liq(1,:) = [liq_over, liq_over, liq_under, liq_over, liq_nvp]

    call PostPercolation_AdjustLayerThicknesses(bounds, num_snowc, filter_snowc, &
         col%snl(bounds%begc:bounds%endc), h2osoi_ice, h2osoi_liq, dz)

    @assertEqual(dz_thin, dz(1,jtop-1), tolerance=tol)
    @assertEqual(liq_over/denh2o, dz(1,jtop), tolerance=tol)
    @assertEqual(dz_thick, dz(1,jtop+1), tolerance=tol)
    @assertEqual(liq_over/denh2o, dz(1,jbot), tolerance=tol)
    @assertEqual(dz_nvp, dz(1,j_moss), tolerance=tol)
  end subroutine postPercolation_nvp

  @Test
  subroutine postPercolation_stock(this)
    ! On a stock column, whose pack reaches down to the soil surface with no moss slot
    ! beneath it, PostPercolation_AdjustLayerThicknesses must thicken the bottom snow
    ! layer along with the rest of the pack while still leaving the empty slots above the
    ! pack at the thicknesses they came in with.
    !
    ! The same arrays and the same snl on a stock column, where jbot_sno = 0 puts the
    ! pack at -2..0, one slot deeper. Now -3 is the slot above the pack and keeps 0.01,
    ! while index 0 is ordinary bottom snow and grows to liq_nvp/denh2o = 0.1. The
    ! excluded and included slots swap relative to the NVP case, so between the two tests
    ! each end of the range is pinned from both sides.
    class(TestPostPercolation), intent(inout) :: this
    ! The layer count the column carries throughout; the routine never changes it.
    integer, parameter :: snl = -3
    ! jbot_sno is 0 on a stock column, so the pack's top slot is snl+1 -- one lower than
    ! the same snl would give on an NVP column -- and get_jbot_snow puts its bottom slot
    ! at the soil surface, leaving two empty slots above the pack instead of one.
    integer, parameter :: jtop = snl + 1
    integer, parameter :: jbot = 0
    integer :: num_snowc
    integer, allocatable :: filter_snowc(:)
    real(r8) :: h2osoi_ice(1,-my_nlevsno+1:0)
    real(r8) :: h2osoi_liq(1,-my_nlevsno+1:0)
    real(r8) :: dz(1,-my_nlevsno+1:0)

    call setup_single_veg_patch(pft_type = 1)
    call filter_from_range(bounds%begc, bounds%endc, num_snowc, filter_snowc)
    col%snl(bounds%begc:bounds%endc) = snl
    col%jbot_sno(bounds%begc:bounds%endc) = 0

    ! Identical to the NVP case: slots -4, -3, -2, -1, 0 in that order.
    h2osoi_ice(:,:) = 0._r8
    dz(1,:) = [dz_thin, dz_thin, dz_thick, dz_thin, dz_nvp]
    h2osoi_liq(1,:) = [liq_over, liq_over, liq_under, liq_over, liq_nvp]

    call PostPercolation_AdjustLayerThicknesses(bounds, num_snowc, filter_snowc, &
         col%snl(bounds%begc:bounds%endc), h2osoi_ice, h2osoi_liq, dz)

    @assertEqual(dz_thin, dz(1,jtop-2), tolerance=tol)
    @assertEqual(dz_thin, dz(1,jtop-1), tolerance=tol)
    @assertEqual(dz_thick, dz(1,jtop), tolerance=tol)
    @assertEqual(liq_over/denh2o, dz(1,jtop+1), tolerance=tol)
    @assertEqual(liq_nvp/denh2o, dz(1,jbot), tolerance=tol)
  end subroutine postPercolation_stock

end module test_SnowHydrology_postPercolation
